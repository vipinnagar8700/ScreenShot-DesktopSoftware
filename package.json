{
  "name": "your-app-name",
  "version": "1.0.0",
  "description": "Description of your app",
  "author": "Your Name",
  "main": "main.js",
  "dist": "electron-builder",
  "scripts": {
    "start": "electron .",
    "package-win": "electron-packager . MyApp --platform=win32 --arch=x64 --out=dist/ --overwrite",
    "build-win": "electron-builder --win"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cross-env": "^7.0.3",
    "ejs": "^3.1.10",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.1",
    "gulp": "^5.0.0",
    "node-notifier": "^10.0.1",
    "play-sound": "^1.1.6",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "sharp": "^0.33.5",
    "wait-on": "^8.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.6.1",
    "concurrently": "^9.1.0",
    "electron": "^24.8.8",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2",
    "electron-windows-installer": "^1.7.8",
    "electron-winstaller": "^5.4.0",
    "gulp": "^4.0.2"
  },
  "build": {
    "appId": "com.employeetrack.app",
    "productName": "EmployeeTrack",
    "win": {
      "target": "nsis",
      "icon": "path/to/your/app-icon.ico"
    },
    "mac": {
      "icon": "path/to/your/mac-icon.icns"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "dist/**/*"
    ],
    "asar": true,
    "directories": {
      "output": "dist"
    }
  }
}
